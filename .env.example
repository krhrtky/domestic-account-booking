# Database
DATABASE_URL=Generate connection string from your PostgreSQL provider (Neon, Supabase, etc.)

# NextAuth.js
NEXTAUTH_SECRET=Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Seed Users (Optional - customize before running seed script)
SEED_USER_A_EMAIL=demo-a@example.com
SEED_USER_A_PASSWORD=Specify your own password for demo user A
SEED_USER_A_NAME=ユーザーA

SEED_USER_B_EMAIL=demo-b@example.com
SEED_USER_B_PASSWORD=Specify your own password for demo user B
SEED_USER_B_NAME=ユーザーB
