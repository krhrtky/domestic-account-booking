# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# User Seed Configuration (for scripts/seed-local.ts)
# If not set, defaults will be used
SEED_USER_A_EMAIL=demo-a@example.com
SEED_USER_A_PASSWORD=Password123!
SEED_USER_A_NAME=デモユーザーA

SEED_USER_B_EMAIL=demo-b@example.com
SEED_USER_B_PASSWORD=Password123!
SEED_USER_B_NAME=デモユーザーB

# E2E Testing (required for Playwright tests)
# Note: DATABASE_URL is required for test user management
